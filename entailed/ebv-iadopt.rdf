  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/CC_com_FW_benthicInvertebrates_EQR">
    <skos:narrower rdf:resource="http://w3id.org/ad4gd/ev/ebv/CC_com_FW_benthicInvertebrates_EQR_Prod1"/>
    <skos:definition>Composition of benthic invertebrates in the European catchments and rivers network system (ECRINS), as measured by the Ecological Quality Ratio (EQR) of indicator taxa.</skos:definition>
    <iadopt:hasObjectOfInterest rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/benthicInvertebrates"/>
    <iadopt:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/freshwater"/>
    <skos:prefLabel>Community abundance of freshwater benthic invertebrates ecological quality ratio</skos:prefLabel>
    <ns1:status rdf:resource="http://www.opengis.net/def/status/valid"/>
    <rdf:type rdf:resource="https://w3id.org/iadopt/ont/Variable"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://w3id.org/ad4gd/ev/EBV"/>
    <skos:inScheme rdf:resource="http://w3id.org/ad4gd/ev/ebv"/>
    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/Community_abundance"/>
    <iadopt:hasProperty rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/ecologicalQualityRatio"/>
  </rdf:Description>
