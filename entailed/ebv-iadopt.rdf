  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/EF_pro_FW_biomassProduction_SCC">
    <skos:prefLabel>Primary productivity of freshwater biomass production surface chlorophyll-a concentrations</skos:prefLabel>
