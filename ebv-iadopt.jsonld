          ],
          "hasMember": [
            {
              "@id": "ad4gd-ebv:EF_pro_FW_biomassProduction_BIO",
              "@type": [
                "EBV",
                "Concept",
                "Variable"
              ],
              "hasBroader": "ad4gd-ebv:Primary_productivity",
              "definition": "Productivity in an ecosystem refers to the percentage of energy that enters the ecosystem in the form of biomass at a particular trophic level. It is the rate at which biomass is formed in EU freshwater ecosystems and transitional waters.",
              "inScheme": "ad4gd-ev:ebv",
              "hasNarrower": {
                "@id": "ad4gd-ebv:EF_pro_FW_biomassProduction_BIO_Prod1",
                "@type": [
