                  "Product"
                ],
                "hasBroader": "ad4gd-ebv:EF_pro_FW_biomassProduction_BIO",
                "inScheme": "ad4gd-ev:ebv",
                "label": "Primary productivity of freshwater biomass production biomass product",
                "measures": "ad4gd-ebv:EF_pro_FW_biomassProduction_BIO",
                "spatialResolution": "Catchment units (add hierarchy level) and estuarine-marine habitats (marshes, estuaries)",
                "ad4gd:temporalResolutionStart": "1year"
              },
              "label": "Primary productivity of freshwater biomass production biomass",
              "hasConstraint": {
